# Concat di-spawn sebagai proses MCP (concat --mcp headless) oleh worker,
# jadi worker harus berjalan di mesin yang sama dengan concat binary.
# data_dir harus di bawah batas tulis concat (laporan mcp.writesUnder),
# di Windows biasanya di bawah folder home user.
VF_DATA_DIR=/home/video/videoflow
VF_DATABASE_URL=postgresql://videoflow:videoflow@localhost:5432/videoflow
VF_REDIS_URL=redis://localhost:6379/0

# Kosong = cari otomatis (VF_CONCAT_BIN -> %LOCALAPPDATA%\Programs\Concat ->
# C:\Program Files\Concat -> PATH).
VF_CONCAT_BIN=
VF_CONCAT_MODE=headless

VF_WHISPER_MODEL=large-v3
VF_WHISPER_DEVICE=cuda
VF_WHISPER_LANG=id

# Origin dashboard yang boleh memanggil API ini dari browser (pemisah koma).
# Dashboard membaca API dari NEXT_PUBLIC_API_URL, default http://127.0.0.1:8000.
VF_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

VF_EXPORT_CRF=19
VF_EXPORT_PRESET=medium
VF_EXPORT_CODEC=h264
VF_RENDER_TIMEOUT_S=1800
